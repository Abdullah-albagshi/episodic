{
  "expo": {
    "name": "Episodic",
    "slug": "episodic",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "episodic",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b0b12"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.episodic.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.episodic.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b0b12"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ]
  }
}
